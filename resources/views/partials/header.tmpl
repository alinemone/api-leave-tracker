{{ define "partials/header.tmpl" }}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ .title }} | رخصت</title>
    <style>
        @font-face { font-family: 'Vazirmatn'; src: url('/fonts/Vazirmatn-Thin.woff2') format('woff2'); font-weight: 100; font-display: swap; }
        @font-face { font-family: 'Vazirmatn'; src: url('/fonts/Vazirmatn-ExtraLight.woff2') format('woff2'); font-weight: 200; font-display: swap; }
        @font-face { font-family: 'Vazirmatn'; src: url('/fonts/Vazirmatn-Light.woff2') format('woff2'); font-weight: 300; font-display: swap; }
        @font-face { font-family: 'Vazirmatn'; src: url('/fonts/Vazirmatn-Regular.woff2') format('woff2'); font-weight: 400; font-display: swap; }
        @font-face { font-family: 'Vazirmatn'; src: url('/fonts/Vazirmatn-Medium.woff2') format('woff2'); font-weight: 500; font-display: swap; }
        @font-face { font-family: 'Vazirmatn'; src: url('/fonts/Vazirmatn-SemiBold.woff2') format('woff2'); font-weight: 600; font-display: swap; }
        @font-face { font-family: 'Vazirmatn'; src: url('/fonts/Vazirmatn-Bold.woff2') format('woff2'); font-weight: 700; font-display: swap; }
        @font-face { font-family: 'Vazirmatn'; src: url('/fonts/Vazirmatn-ExtraBold.woff2') format('woff2'); font-weight: 800; font-display: swap; }
        @font-face { font-family: 'Vazirmatn'; src: url('/fonts/Vazirmatn-Black.woff2') format('woff2'); font-weight: 900; font-display: swap; }
        :root {
            --primary: #a1233b;
            --primary-050: #fbeef0;
            --primary-100: #f2d3da;
            --primary-200: #e8b0bb;
            --primary-300: #de8d9c;
            --primary-400: #d46a7d;
            --primary-500: #a1233b;
            --primary-600: #8c1f34;
            --primary-700: #761b2c;
            --primary-800: #611724;
            --primary-900: #4b131c;
            --primary-dark: #8c1f34;
            --bg: #f4f5f7;
            --card: #ffffff;
            --text: #2b2f36;
            --muted: #8a93a2;
            --border: #e6e8ec;
            --danger: #e23b3b;
            --success: #2faa6a;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: Vazirmatn, Tahoma, "Segoe UI", sans-serif;
            background: #e6e8ec;
            color: var(--text);
            line-height: 1.7;
        }
        /* Mobile-only frame: the whole app is a centered narrow column even on desktop. */
        .app {
            max-width: 444px;
            margin: 0 auto;
            min-height: 100vh;
            background: var(--bg);
            box-shadow: 0 0 24px rgba(0,0,0,.06);
        }
        a { color: inherit; text-decoration: none; }
        .topbar {
            display: flex;
            align-items: center;
            background: var(--card);
            padding: 10px 24px;
            border-bottom: 1px solid var(--border);
            box-shadow: 0 1px 3px rgba(0,0,0,.03);
            flex-wrap: wrap;
        }
        .brand { display: flex; align-items: center; gap: 10px; }
        .brand-logo { width: 34px; height: 42px; object-fit: contain; }
        .brand-name { font-size: 20px; font-weight: 800; color: var(--primary); }
        .topbar nav { display: flex; justify-content: space-between; order: 3; width: 100%; overflow-x: auto; padding-bottom: 2px; }
        .topbar nav a {
            padding: 8px 14px; border-radius: 8px; color: var(--muted); font-weight: 600; white-space: nowrap;
        }
        .topbar nav a.active, .topbar nav a:hover { background: var(--primary-050); color: var(--primary); }
        .topbar .user { margin-inline-start: auto; display: flex; align-items: center; gap: 12px; }
        .container { margin: 16px auto; padding: 0 16px; }
        .card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: 14px; padding: 18px; margin-bottom: 18px;
            overflow-x: auto;
        }
        .card h2 { margin: 0 0 16px; font-size: 18px; }
        .row { display: flex; flex-direction: column; align-items: stretch; gap: 6px; margin-bottom: 14px; }
        .row label { color: var(--muted); font-weight: 600; }
        input, select {
            width: 100%;
            padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px;
            font-family: inherit; font-size: 14px; background: #fff; color: var(--text);
        }
        .btn {
            display: inline-block; padding: 10px 22px; border-radius: 8px; border: none;
            font-family: inherit; font-size: 15px; font-weight: 700; cursor: pointer;
        }
        .btn-primary { background: var(--primary); color: #fff; }
        .btn-primary:hover { background: var(--primary-dark); }
        .btn-outline { background: #fff; color: var(--primary); border: 1px solid var(--primary); padding: 10px 22px; border-radius: 8px; font-weight: 700; font-size: 15px; }
        .btn-outline:hover { background: var(--primary-050); }
        .btn-link { background: none; border: none; cursor: pointer; font-family: inherit; font-weight: 600; color: var(--muted); }
        .btn-link.danger { color: var(--danger); }
        table { width: 100%; border-collapse: collapse; }
        th, td { text-align: right; padding: 12px 10px; border-bottom: 1px solid var(--border); white-space: nowrap; }
        /* Let wide tables scroll horizontally inside their card instead of squishing. */
        .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 0 -4px; }
        .table-scroll table { min-width: 480px; }
        th { color: var(--muted); font-size: 13px; font-weight: 700; }
        .empty { color: var(--muted); text-align: center; padding: 24px 0; }
        .alert { padding: 12px 16px; border-radius: 10px; margin-bottom: 18px; font-weight: 600; }
        .alert.error { background: #fdecec; color: var(--danger); }
        .alert.success { background: #e8f7ef; color: var(--success); }
        .pager { display: flex; align-items: center; gap: 16px; justify-content: center; margin-top: 18px; }
        .pager a { padding: 6px 14px; border: 1px solid var(--border); border-radius: 8px; font-weight: 600; }
        .pager a:hover { border-color: var(--primary); color: var(--primary); }
        .divider { display: flex; align-items: center; text-align: center; color: var(--muted); font-size: 13px; margin: 18px 0; }
        .divider::before, .divider::after { content: ""; flex: 1; height: 1px; background: var(--border); }
        .divider::before { margin-left: 12px; }
        .divider::after { margin-right: 12px; }
        .auth-logo { display: block; width: 56px; height: 70px; object-fit: contain; margin: 0 auto 8px; }
        .auth-wrap { max-width: 444px; margin: 24px auto; padding: 0 16px; }
        .auth-title { text-align: center; font-size: 18px; font-weight: 800; margin: 8px 0 28px; }
        .field-label { display: block; text-align: right; font-weight: 600; color: var(--text); margin-bottom: 8px; }
        .field-label .req { color: var(--primary); }
        .field { width: 100%; padding: 12px 14px; border: 1px solid var(--border); border-radius: 8px; font-family: inherit; font-size: 14px; margin-bottom: 18px; }
        .field-password { position: relative; margin-bottom: 18px; }
        .field-password .field { margin-bottom: 0; padding-left: 44px; }
        .eye { position: absolute; left: 8px; top: 21px; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--muted); font-size: 17px; padding: 4px; }
        .btn-block { width: 100%; display: block; text-align: center; }
        .auth-alt { text-align: center; color: var(--muted); margin-top: 22px; }
        .auth-alt a { color: var(--primary); font-weight: 700; }
        .auth-forgot { text-align: center; margin-top: 36px; }
        .auth-forgot a { color: var(--primary); font-weight: 600; }
        th, td { padding: 10px 6px; font-size: 13px; }
        form .btn { width: 100%; }
        /* Mobile-style bottom navigation */
        main.container { padding-bottom: 86px; }
        .bottomnav {
            position: fixed; bottom: 0; left: 50%; transform: translateX(-50%);
            width: 100%; max-width: 444px; background: #fff; border-top: 1px solid var(--border);
            display: flex; justify-content: space-around; padding: 6px 4px 8px;
            box-shadow: 0 -2px 10px rgba(0,0,0,.05); z-index: 50;
        }
        .bottomnav a {
            display: flex; flex-direction: column; align-items: center; gap: 3px;
            flex: 1; font-size: 11px; color: var(--muted); font-weight: 600; padding: 4px 2px;
        }
        .bottomnav a.active { color: var(--primary); }
        .bottomnav svg { width: 22px; height: 22px; display: block; }
    </style>
</head>
<body>
<div class="app">
<header class="topbar">
    {{ if .user }}
    <a class="brand" href="/leaves-me">
        <img class="brand-logo" src="/logo.png" alt="رخصت">
        <span class="brand-name">{{ trans "app.name" }}</span>
    </a>
    <div class="user">
        <a href="/profile" style="font-weight:600;color:var(--text)">{{ .user.Name }}</a>
        <form action="/logout" method="POST" style="margin:0">
            <button type="submit" class="btn-link">{{ trans "nav.logout" }}</button>
        </form>
    </div>
    {{ else }}
    <img class="brand-logo" src="/logo.png" alt="رخصت">
    <span class="brand-name">{{ trans "app.name" }}</span>
    {{ end }}
</header>
<main class="container">
{{ end }}
